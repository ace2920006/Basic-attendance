# ==============================================================================
# Attendance Management System - Backend Server Environment Variables
# ==============================================================================

# Database Configuration (Required)
MONGODB_URI=mongodb://127.0.0.1:27017/attendance_db

# Authentication & Security Secrets (Required)
JWT_SECRET=your_jwt_access_token_secret_key_here
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key_here
JWT_REFRESH_EXPIRE=7d

# Server & Client Connectivity
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Cloud Messaging (Optional)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email Service / Nodemailer (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
FROM_EMAIL=noreply@attendance.edu
FROM_NAME="Attendance Portal Administration"

# Storage & Malware Scanner (Phase 31)
UPLOAD_PATH=uploads
SECURE_UPLOAD_PATH=secure_uploads/documents
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
