# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Required)
MONGODB_URI=mongodb://127.0.0.1:27017/attendance_db

# Security & Authentication Secrets (Required)
JWT_SECRET=your_jwt_access_token_secret_key_here
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key_here
JWT_REFRESH_EXPIRE=7d

# File Upload Configuration
UPLOAD_PATH=uploads

# CORS & Client Configuration (Optional)
CLIENT_URL=http://localhost:5173

# Firebase Cloud Messaging Credentials (Optional)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_PROJECT_ID=your_firebase_project_id
